# Path to the Aurral SQLite database (mounted read-only)
AURRAL_DB=/data/aurral/aurral.db

# Container download root written in Aurral's final_path values
AURRAL_DS_ROOT=/app/downloads

# Where those downloaded files live from THIS container's point of view
EXPORT_SRC_ROOT=/data/downloads

# Where Rekordbox/<Playlist Name>/ folders are written
EXPORT_ROOT=/data/downloads/Rekordbox

PORT=3001
HOST=0.0.0.0